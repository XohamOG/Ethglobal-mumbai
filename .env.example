# =============================================================================
# DeFi Provenance Graph - Environment Variables Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Arkiv Network (Rabdi Testnet - Chain ID: 7794095)
# -----------------------------------------------------------------------------
# Arkiv RPC Access Key for authentication and Sourcify mirroring
ARKIV_ACCESS_KEY=your_arkiv_access_key_here

# Private key for minting/signing Arkiv entities (ContractNode, RiskSnapshot, ProtocolRegistry)
# Must hold Rabdi tGLM for gas
ARKIV_PRIVATE_KEY=your_evm_private_key_here

# Frontend public access key for reading Arkiv query client
NEXT_PUBLIC_ARKIV_ACCESS_KEY=your_arkiv_access_key_here

# -----------------------------------------------------------------------------
# Ethereum L1 RPC
# -----------------------------------------------------------------------------
# Public or private archive/full node RPC to query on-chain proxy slots & state
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com

# -----------------------------------------------------------------------------
# Swarm Decentralized Storage
# -----------------------------------------------------------------------------
# Swarm gateway or local Bee node URL
SWARM_GATEWAY_URL=https://api.gateway.ethswarm.org
NEXT_PUBLIC_SWARM_GATEWAY=https://api.gateway.ethswarm.org

# Optional Swarm postage batch ID for uploading persistence
SWARM_POSTAGE_BATCH_ID=your_postage_batch_id_here

# -----------------------------------------------------------------------------
# Services & Ports
# -----------------------------------------------------------------------------
PORT=4000
NEXT_PUBLIC_GRAPH_SERVICE_URL=http://localhost:4000
