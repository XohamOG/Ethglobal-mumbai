# Arkiv Network Configuration (Rabdi Testnet - Chain ID: 7794095)
ARKIV_ACCESS_KEY=your_arkiv_access_key_here
ARKIV_PRIVATE_KEY=your_evm_private_key_here

# Ethereum RPC for reading live protocol state (Mainnet / Sepolia)
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com

# Swarm Decentralized Storage
SWARM_GATEWAY_URL=https://api.gateway.ethswarm.org
SWARM_POSTAGE_BATCH_ID=your_postage_batch_id_here

# Service Port
PORT=4000


# Optional: require this key (x-api-key header) on POST /rebuild. Same value goes in
# cre/cre-project/.env as GRAPH_SERVICE_API_KEY_ENV. Leave unset for local dev.
CRE_API_KEY=
